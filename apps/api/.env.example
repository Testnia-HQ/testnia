# Testnia API server environment (copy to .env)
# All values are examples — never commit a real .env.

# Server
PORT=3001

# CORS — the web app origin(s) allowed to call this API.
# Comma-separated list. On VPS: https://testnia.com,https://www.testnia.com
CORS_ORIGIN=https://testnia.com,https://www.testnia.com

# PocketBase — internal (server-to-server) connection
PB_HOST=http://pocketbase:8090
PB_SUPERUSER_EMAIL=superuser@example.com
PB_SUPERUSER_PASSWORD=CHANGE_ME

# PocketBase — public, browser-reachable base URL (used for image/file URLs in AI flows)
PB_PUBLIC_URL=https://pb.testnia.com

# DeepSeek-compatible AI proxy
INTEGRATED_AI_API_URL=
INTEGRATED_AI_API_KEY=
PROXY_ENTRANCE_ID=
WEBSITE_ID=

# Payment (Paystack test key)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Frontend origin used to build payment callback URLs
WEBSITE_URL=https://testnia.com

# Node environment
NODE_ENV=production
