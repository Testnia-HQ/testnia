# Testnia PocketBase environment (copy to .env) — passed to the PocketBase binary

# Meta app settings — overrides baked-in values on every boot (see pb_hooks/sync-app-settings.pb.js).
# On VPS these MUST be set to the public domain so emails/links resolve correctly.
PB_APP_NAME=Testnia
PB_APP_URL=https://pb.testnia.com

# PocketBase encryption key (required for VPS. Generate with: openssl rand -base64 32)
PB_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64

# Mailer — used by pb_hooks/builder-mailer.pb.js when SMTP is disabled
BUILDER_MAILER_API_URL=
BUILDER_MAILER_API_KEY=
BUILDER_MAILER_SENDER_ADDRESS=

# SMTP (alternative to builder mailer) — PocketBase-native
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
