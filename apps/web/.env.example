# Testnia web app environment (copy to .env) — consumed by Vite at build time
# Only VITE_* prefixed vars are exposed to the client bundle.

# PocketBase public URL
#   Horizons (legacy): leave unset → falls back to /hcgi/platform
#   VPS (subdomain):   https://pb.testnia.com
#   VPS (single domain + nginx): /pb
VITE_PB_URL=https://pb.testnia.com

# Express API public URL
#   Horizons (legacy): leave unset → falls back to /hcgi/api
#   VPS (subdomain):   https://api.testnia.com
#   VPS (single domain + nginx): /api
VITE_API_URL=https://api.testnia.com
