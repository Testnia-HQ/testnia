# Root .env for the Testnia Docker stack (copy to .env on the VPS, or pass via
# the deploy action's environment-variables / GitHub secrets). Values shown are
# examples for the VPS + subdomain layout (testnia.com / pb. / api.).

# Web app build-time URLs (baked into the static bundle)
VITE_PB_URL=https://pb.testnia.com
VITE_API_URL=https://api.testnia.com

# PocketBase public URL + app name (used for email links, file URLs)
PB_APP_NAME=Testnia
PB_APP_URL=https://pb.testnia.com
PB_PUBLIC_URL=https://pb.testnia.com

# PocketBase internal service is always http://pocketbase:8090 (set in compose).

# PocketBase encryption key — REQUIRED. Generate: openssl rand -base64 32
PB_ENCRYPTION_KEY=

# PocketBase superuser (used by the API to auth against PB)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# CORS — web origin(s) allowed to call the API. Single origin for MVP.
CORS_ORIGIN=https://testnia.com

# Payment
PAYSTACK_SECRET_KEY=
WEBSITE_URL=https://testnia.com

# DeepSeek-compatible AI proxy
INTEGRATED_AI_API_URL=
INTEGRATED_AI_API_KEY=
PROXY_ENTRANCE_ID=
WEBSITE_ID=

# Mailer (used by pb_hooks/builder-mailer.pb.js when SMTP is disabled)
BUILDER_MAILER_API_URL=
BUILDER_MAILER_API_KEY=
BUILDER_MAILER_SENDER_ADDRESS=
